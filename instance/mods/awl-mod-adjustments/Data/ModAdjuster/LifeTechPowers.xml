<!-- AWL Mod Adjustments: Life'Tech-Powers (2558149005) rebalanced around deuterium ore (docs/deuterium-fusion.md).
     Applied by ModAdjusterV2 at LoadData, on the server and every client. ProducedGases and ItemIds REPLACE
     the whole list, so each is restated in full. A "Loaded definition" line in ModAdjuster's log means the
     field was written, not that SE uses it: SE builds inventory constraints and the G menu from definitions
     before ModAdjuster runs, so check the effect in game. -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!-- Vaporizer: 11.52 L per unit of deuterium ore, mined or synthesised (was 24). Inputs and rate stay Life'Tech's own: SE fixes a gas generator's accepted items before ModAdjuster runs, and one ratio applies to every input. -->
    <Definition xsi:type="MyObjectBuilder_OxygenGeneratorDefinition">
      <Id>
        <TypeId>OxygenGenerator</TypeId>
        <SubtypeId>LG_DeuteriumVaporizer</SubtypeId>
      </Id>
      <ProducedGases>
          <GasInfo>
            <Id>
              <TypeId>GasProperties</TypeId>
              <SubtypeId>Deuterium</SubtypeId>
            </Id>
            <IceToGasRatio>11.52</IceToGasRatio>
          </GasInfo>
      </ProducedGases>
    </Definition>
    <!-- Processor: no deuterium from ice (was 6 L per ice). Public=false hides it from the G menu, which SE checks each time the screen opens; placed blocks keep working. -->
    <Definition xsi:type="MyObjectBuilder_OxygenGeneratorDefinition">
      <Id>
        <TypeId>OxygenGenerator</TypeId>
        <SubtypeId>LG_DeuteriumProcessor</SubtypeId>
      </Id>
      <Public>false</Public>
      <ProducedGases>
          <GasInfo>
            <Id>
              <TypeId>GasProperties</TypeId>
              <SubtypeId>Oxygen</SubtypeId>
            </Id>
            <IceToGasRatio>8</IceToGasRatio>
          </GasInfo>
          <GasInfo>
            <Id>
              <TypeId>GasProperties</TypeId>
              <SubtypeId>Hydrogen</SubtypeId>
            </Id>
            <IceToGasRatio>16</IceToGasRatio>
          </GasInfo>
      </ProducedGases>
    </Definition>
    <!-- Separator: a token 0.01 L H2 per stone (was 5 L D2 + 10 L H2 from any rock). Its stone input cannot be removed; 0 would divide by zero in SE's consumption. Public=false hides it. -->
